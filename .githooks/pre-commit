#!/bin/sh
# nemik:W92: the commit gate. Whether tests need to run is the build graph's call, not the committer's:
# bazel re-runs exactly the test targets whose inputs changed and answers the rest from cache, so a
# queue-only commit costs a cache lookup. Enable once per clone: git config core.hooksPath .githooks
#
# It tests the working tree, not the staged index: unstaged edits count. Stash them to gate the index alone.
set -e
cd "$(git rev-parse --show-toplevel)"
# vendor/wheels/.gitignore is `*`, so a rebuilt wheel exists on disk (and satisfies bazel here) yet is
# not in the commit; the image build then fails from a clean checkout (nemik:W276, 2026-10-10).
# Every wheel pyproject.toml names must be in the index.
missing=$(grep -o 'vendor/wheels/[^"]*\.whl' pyproject.toml | while read -r wheel; do
	git ls-files --error-unmatch "$wheel" >/dev/null 2>&1 || echo "$wheel"
done)
if [ -n "$missing" ]; then
	echo "pre-commit: not tracked (vendor/wheels/.gitignore hides them; git add -f): $missing" >&2
	exit 1
fi
# nemik:W319 (operator 2026-10-11: agents rarely marking a card `working` is a discipline problem, so
# it is enforced, not advised): a commit that changes code or tests while the queue has ready cards
# and NO working card is refused. Mark the card you are doing first:
#   mikemol-paths-forward --state .claude/paths-forward.json --update W<n> --status working
# A queue-only commit (nothing staged under src/ or tests/) is exempt, and so is a queue with nothing ready.
if [ -n "$(git diff --cached --name-only -- src tests)" ] &&
	grep -q '"status": "ready"' .claude/paths-forward.json &&
	! grep -q '"status": "working"' .claude/paths-forward.json; then
	echo "pre-commit: code or tests changed, the queue has ready cards, and none is marked working." >&2
	echo "  mark the card you are doing: mikemol-paths-forward --state .claude/paths-forward.json --update W<n> --status working" >&2
	exit 1
fi
exec bazel test //... --noshow_progress
