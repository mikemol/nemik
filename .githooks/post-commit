#!/bin/sh
# nemik: push after every commit that passed the gate (.githooks/pre-commit). A push to main is a Flux
# ship (Forgejo build -> deploy-state -> ns nemik), so a commit here is a deploy: the gate is the only
# thing between them. Operator 2026-10-09: "add git-push to the postcommit hook".
#
# Skipped when there is nowhere to push (detached HEAD, no upstream) or the commit is part of a rebase.
# A failed push never undoes the commit; it prints and leaves the commit local to be pushed by hand.
cd "$(git rev-parse --show-toplevel)" || exit 0
git_dir=$(git rev-parse --git-dir)
if [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ]; then
	exit 0
fi
# nemik:W819: the Bazel-built .venv symlinks each src/nemik file, so an edit is seen at once, but a file a
# commit added, removed or renamed is not there until the venv is built again. Luthen's nemik_check gate
# runs that venv's nemik-check: after W818 added nemik/core it crashed on import and paged unexpected_red
# (2026-10-20). So such a commit rebuilds it, detached, whether or not there is anywhere to push.
moved=$(git diff-tree --no-commit-id --name-only -r --diff-filter=ADR HEAD -- src/nemik)
if [ -n "$moved" ] && command -v bazel >/dev/null 2>&1; then
	setsid nohup bazel build //:.venv --show_result=0 --noshow_progress >/dev/null 2>&1 &
fi
branch=$(git symbolic-ref --quiet --short HEAD) || exit 0
git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1 || exit 0
git push --quiet || echo "post-commit: push of $branch failed; the commit stays local" >&2
# nemik:W1655 (mtools:W2171, W1920): the LANDED sample of the ratchet series is sent here, after the
# commit exists and the gate verified it. The gate's own emit sends the staged tree's values BEFORE its
# verdict and carries no stage, so a gate the host cancelled (kine-latency, nemik stack 1003) left its
# values in the series and the pace read a fall that never landed. This sample carries stage=landed.
# The reader's path is this repository's to name (RATCHET_BIN). Detached and queued behind an earlier
# one by a blocking flock, so git never waits on a census; an absent tool is a silent skip.
real_root="${MIKEMOL_REAL_ROOT:-$(git rev-parse --show-toplevel)}"
emit="$real_root/.venv/bin/mikemol-ratchet-emit"
if [ -x "$emit" ]; then
	mkdir -p "$git_dir/mtools"
	RATCHET_BIN="$real_root/.venv/bin/mikemol-ratchet" setsid flock "$git_dir/mtools/ratchet-emit.lock" \
		"$emit" "$(basename "$real_root")" "$(git rev-parse --show-toplevel)" landed \
		</dev/null >"$git_dir/mtools/ratchet-emit.log" 2>&1 &
fi
# nemik:W591: replay the image's test stage on what was pushed (about 16 minutes, nemik:W588), detached
# and single-flight (the runner takes a lock), so the commit returns at once and a burst of commits is
# replayed as the newest. The result lands in .git/image-replica.last for the tick to read (W592).
if [ -x tools/image_replica_runner.sh ]; then
	setsid nohup tools/image_replica_runner.sh >/dev/null 2>&1 &
fi
exit 0
