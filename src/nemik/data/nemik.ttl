@prefix nemik: <https://github.com/mikemol/nemik/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix oslc_cm: <http://open-services.net/ns/cm#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Extension vocabulary for what OSLC CM 3.0 and ForgeFed do not carry (docs/specs-survey.md).

nemik:Workstream a rdfs:Class ; rdfs:comment "One repo's agent-run paths-forward queue (an OSLC ServiceProvider / ForgeFed actor)." .
nemik:workstream a rdf:Property ; rdfs:comment "The workstream that owns this waypoint." .
nemik:symbol a rdf:Property ; rdfs:comment "The waypoint's W<n> symbol, never reused within its workstream." .
nemik:enables a rdf:Property ; rdfs:comment "This waypoint unblocks the object waypoint (inverse of depends-on)." .
nemik:blockedOn a rdf:Property ; rdfs:comment "Free-text name of what the waypoint waits on." .
nemik:blockedKind a rdf:Property ; rdfs:comment "agent | human." .
nemik:touches a rdf:Property ; rdfs:comment "A tag naming an area the waypoint touches." .

# The four waypoint states, as a SKOS scheme. OSLC CM 3.0 leaves oslc_cm:state's values to the
# provider; these are the values nemik's provider uses (mtools' STATUSES).
nemik:WaypointStates a skos:ConceptScheme ;
    skos:prefLabel "paths-forward waypoint states" ;
    skos:hasTopConcept nemik:Ready, nemik:Working, nemik:Blocked, nemik:Done .
nemik:Ready a skos:Concept ; skos:inScheme nemik:WaypointStates ; skos:prefLabel "ready" .
nemik:Working a skos:Concept ; skos:inScheme nemik:WaypointStates ; skos:prefLabel "working" .
nemik:Blocked a skos:Concept ; skos:inScheme nemik:WaypointStates ; skos:prefLabel "blocked" .
nemik:Done a skos:Concept ; skos:inScheme nemik:WaypointStates ; skos:prefLabel "done" .
nemik:Dropped a rdfs:Class ; rdfs:comment "A residue entry: a symbol that was issued and dropped, still resolvable." .
nemik:kind a rdf:Property ; rdfs:comment "The ledger line's raw kind column (free text upstream)." .
nemik:effortClass a rdf:Property ; rdfs:comment "forecast | interrupt | unclassified, from nemik's KIND_CLASS reading of kind." .
nemik:outcome a rdf:Property ; rdfs:comment "The ledger line's outcome column." .
nemik:mechanism a rdf:Property ; rdfs:comment "The ledger line's mechanism column." .
nemik:umbrellaBlockOn a rdf:Property ; rdfs:comment "Derived: this waypoint waits on another workstream's waypoint that its own repo's open children enable (an umbrella)." .
nemik:landedBlocker a rdf:Property ; rdfs:comment "Derived (nemik:W110): this open waypoint waits on the object waypoint, which has already landed (done or dropped)." .
nemik:allBlockersLanded a rdf:Property ; rdfs:comment "Derived (nemik:W110): every blocked_on entry of this open waypoint names a waypoint that has landed; it is ready, not blocked." .
nemik:malformedBlocker a rdf:Property ; rdfs:comment "Derived (nemik:W110): a blocked_on entry that is a symbol with prose attached, so it draws no edge." .
nemik:vector a rdf:Property ; rdfs:comment "The waypoint's WV:1 priority vector as its queue stores it (mtools:W248); banded by nemik.score (nemik:W131)." .
nemik:vectorSource a rdf:Property ; rdfs:comment "Who wrote the vector: default, signal or agent (mtools:W248)." .
nemik:dtstart a rdf:Property ; rdfs:comment "RFC 5545 DTSTART value as the queue stores it (mtools:W300; nemik:W134)." .
nemik:due a rdf:Property ; rdfs:comment "RFC 5545 DUE value as the queue stores it (mtools:W300; nemik:W134)." .
nemik:alarm a rdf:Property ; rdfs:comment "One RFC 5545 VALARM TRIGGER as the queue stores it (mtools:W279); resolved by nemik.alarm (nemik:W129)." .
nemik:rrule a rdf:Property ; rdfs:comment "RFC 5545 RRULE as the queue stores it (mtools:W309)." .
nemik:exdate a rdf:Property ; rdfs:comment "One RFC 5545 EXDATE value as the queue stores it (mtools:W309)." .
nemik:occurrenceDone a rdf:Property ; rdfs:comment "RECURRENCE-ID of a completed occurrence (mtools:W310 occurrences map); nemik.alarm skips it." .
nemik:queuePosition a rdf:Property ; rdfs:comment "0-based index of the waypoint in mtools' model.ordered(): the order its own session works the queue." .
nemik:mintedDuring a rdf:Property ; rdfs:comment "tick | interrupt: whether a live tick lock was held when mtools minted the waypoint." .
nemik:waitsFor a rdf:Property ; rdfs:comment "An edge nemik resolved from free-text blocked_on: to a waypoint (local or repo:W<n>), a workstream, or the operator." .
nemik:stringNotList a rdf:Property ; rdfs:comment "Names a list field (enables, touches, blocked_on) the queue stores as a bare string." .
nemik:unclaimedBlockOn a rdf:Property ; rdfs:comment "This open waypoint waits on the object workstream, and no waypoint of that workstream enables it or was caused by it." .
nemik:operatorAsk a rdf:Property ; rdfs:comment "needs-you | answered | condition | unstated: nemik's reading of a block on the operator (nemik.blocks.operator_category)." .
nemik:ticksBlocked a rdf:Property ; rdfs:comment "mtools' ticks_blocked counter." .
nemik:unresolvedBlocker a rdf:Property ; rdfs:comment "A blocked_on value on a blocked waypoint that resolves to no workstream, waypoint or operator." .
nemik:pathsforwardAdoption a rdf:Property ; rdfs:comment "declared | owner | missing | no-pyproject | unobservable: whether the workstream runs mikemol-paths-forward from its own environment (nemik.adoption)." .
nemik:noActiveCard a rdf:Property ; rdfs:comment "Derived: the workstream has ready items and no working card (value: how many are ready)." .
nemik:extraActiveCards a rdf:Property ; rdfs:comment "Derived: the workstream has more than one working card (value: how many)." .
