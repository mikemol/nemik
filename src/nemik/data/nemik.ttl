@prefix nemik: <https://github.com/mikemol/nemik/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix oslc_cm: <http://open-services.net/ns/cm#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Extension vocabulary for what OSLC CM 3.0 and ForgeFed do not carry (docs/specs-survey.md).

nemik:Workstream a rdfs:Class ; rdfs:comment "One repo's agent-run paths-forward queue (an OSLC ServiceProvider / ForgeFed actor)." .
nemik:workstream a rdf:Property ; rdfs:comment "The workstream that owns this waypoint." .
nemik:symbol a rdf:Property ; rdfs:comment "The waypoint's W<n> symbol, never reused within its workstream." .
nemik:enables a rdf:Property ; rdfs:comment "This waypoint unblocks the object waypoint (inverse of depends-on)." .
nemik:blockedOn a rdf:Property ; rdfs:comment "Free-text name of what the waypoint waits on." .
nemik:blockedKind a rdf:Property ; rdfs:comment "agent | human." .
nemik:touches a rdf:Property ; rdfs:comment "A tag naming an area the waypoint touches." .
nemik:stream a rdf:Property ; rdfs:comment "The run log a prov:Activity row came from, for example apply-set-runs (nemik:W558)." .
nemik:trigger a rdf:Property ; rdfs:comment "What started a run, as its writer names it (nemik:W558, run-row.schema.json)." .
nemik:exitCode a rdf:Property ; rdfs:comment "A run's process exit code (nemik:W558)." .
nemik:verdictState a rdf:Property ; rdfs:comment "The state of a run's verdict object, a separate axis from the nemik:ChangeLifecycle step reached (nemik:W558)." .
nemik:strayWord a rdf:Property ; rdfs:comment "A word in the waypoint's next step that blurs the change-lifecycle steps (nemik:W553)." .
nemik:plannedPath a rdf:Property ; rdfs:comment "An exact repo-relative file the waypoint plans to create or edit, from its manifest (nemik:W612)." .
nemik:sizeClass a rdf:Property ; rdfs:comment "The waypoint's declared size class: small, medium or large (nemik:W612)." .
nemik:hasNextStep a rdf:Property ; rdfs:comment "True when the waypoint still states a next bounded step (nemik:W488)." .
nemik:namesFile a rdf:Property ; rdfs:comment "A repo file path the waypoint's next step names, as written (nemik:W544)." .
# nemik:W529 (standards audit 2026-10-15): terms the code emitted that nemik.ttl never declared.
nemik:letter a rdf:Property ; rdfs:comment "An inbox letter file a waypoint cites or attaches, as a path (nemik:W275)." .
nemik:readyBehindOpen a rdf:Property ; rdfs:comment "Derived (nemik:W465): this ready card has the object, an open card, enabling it, so it waits on it." .
nemik:malformedWarrant a rdf:Property ; rdfs:comment "Derived (nemik:W598): an entry of the card's warrants list that did not parse as JSON-LD; the start of its text." .
nemik:claimsRuling a rdf:Property ; rdfs:comment "Derived (nemik:W597): this open card's prose claims an operator ruling (a phrase declared in rank-weights.toml [rulings]) and the card carries no warrant." .
nemik:Event a rdfs:Class ; rdfs:comment "An event on an operator calendar, read for dated cards (nemik:W183)." .

# The four waypoint states, as a SKOS scheme. OSLC CM 3.0 leaves oslc_cm:state's values to the
# provider; these are the values nemik's provider uses (mtools' STATUSES).
nemik:WaypointStates a skos:ConceptScheme ;
    skos:prefLabel "paths-forward waypoint states" ;
    skos:hasTopConcept nemik:Ready, nemik:Working, nemik:Blocked, nemik:Done .
nemik:Ready a skos:Concept ; skos:inScheme nemik:WaypointStates ; skos:prefLabel "ready" .
nemik:Working a skos:Concept ; skos:inScheme nemik:WaypointStates ; skos:prefLabel "working" .
nemik:Blocked a skos:Concept ; skos:inScheme nemik:WaypointStates ; skos:prefLabel "blocked" .
nemik:Done a skos:Concept ; skos:inScheme nemik:WaypointStates ; skos:prefLabel "done" .
# nemik:W551 (github-8f 2026-10-15): the five distinct steps of a change on the host, which sessions
# mixed under about six words. Each has one definition and the evidence that witnesses it. A run's
# verdict (mtools' corpus/exit-table.json, mtools:W1294) is a separate axis from the step reached.
nemik:witnessedBy a rdf:Property ; rdfs:comment "The evidence that shows a lifecycle step has been reached (nemik:W551)." .
nemik:ChangeLifecycle a skos:ConceptScheme ;
    skos:prefLabel "change lifecycle on the host" ;
    skos:hasTopConcept nemik:Landed, nemik:Installed, nemik:Held, nemik:Enabled, nemik:Active, nemik:Applied .
# nemik:W554 (github-8f 2026-10-15): declared and installed but deliberately not enabled, used all day
# for systemd units and drum rows ("held", "staged"); a real step between installed and enabled.
nemik:Held a skos:Concept ; skos:inScheme nemik:ChangeLifecycle ; skos:prefLabel "held" ;
    skos:altLabel "staged" ;
    skos:definition "The change is installed on the host and deliberately not enabled." ;
    nemik:extension true ;
    nemik:witnessedBy "systemctl is-enabled reports disabled while the unit file is installed" .
# nemik:W552: the OSLC CM 3.0 mapping, read from the published vocabulary (the 303 from
# open-services.net/ns/cm# to docs.oasis-open-projects.org/oslc-op/cm/v3.0/errata01/os/change-mgt-vocab.html,
# fetched 2026-10-15), not from memory. CM's states describe a change request's resolution
# (Fixed, Verified, Closed), not its deployment, so only two steps genuinely fit: a landed commit is
# CM's Fixed ("resolved or fixed but the resolution or fix has not yet been verified") and a converged
# run is its Verified ("the resolution or the fix is verified"). The rest are nemik extensions.
nemik:extension a rdf:Property ; rdfs:comment "True on a lifecycle step with no OSLC CM 3.0 term that fits it (nemik:W552)." .
nemik:Landed a skos:Concept ; skos:inScheme nemik:ChangeLifecycle ; skos:prefLabel "landed" ;
    skos:definition "The change is committed to its repository." ;
    skos:closeMatch oslc_cm:Fixed ;
    nemik:witnessedBy "a git ref containing the commit" .
nemik:Installed a skos:Concept ; skos:inScheme nemik:ChangeLifecycle ; skos:prefLabel "installed" ;
    skos:definition "An apply has written the change's files onto the host." ;
    nemik:extension true ;
    nemik:witnessedBy "a host_live_types row for the written artifact" .
nemik:Enabled a skos:Concept ; skos:inScheme nemik:ChangeLifecycle ; skos:prefLabel "enabled" ;
    skos:definition "The change's trigger is registered with the host's scheduler." ;
    nemik:extension true ;
    nemik:witnessedBy "systemctl is-enabled reports enabled" .
nemik:Active a skos:Concept ; skos:inScheme nemik:ChangeLifecycle ; skos:prefLabel "active" ;
    skos:definition "The change's trigger is armed and can fire now." ;
    nemik:extension true ;
    nemik:witnessedBy "systemctl is-active reports active" .
nemik:Applied a skos:Concept ; skos:inScheme nemik:ChangeLifecycle ; skos:prefLabel "applied" ;
    skos:definition "A run of the change converged on the host." ;
    skos:closeMatch oslc_cm:Verified ;
    nemik:witnessedBy "a run record whose verdict is converged" .
nemik:Dropped a rdfs:Class ; rdfs:comment "A residue entry: a symbol that was issued and dropped, still resolvable." .
nemik:kind a rdf:Property ; rdfs:comment "The ledger line's raw kind column (free text upstream)." .
nemik:effortClass a rdf:Property ; rdfs:comment "forecast | interrupt | unclassified, from nemik's KIND_CLASS reading of kind." .
nemik:outcome a rdf:Property ; rdfs:comment "The ledger line's outcome column." .
nemik:mechanism a rdf:Property ; rdfs:comment "The ledger line's mechanism column." .
nemik:allBlockersLanded a rdf:Property ; rdfs:comment "Derived (nemik:W110): every blocked_on entry of this open waypoint names a waypoint that has landed; it is ready, not blocked." .
nemik:vector a rdf:Property ; rdfs:comment "The waypoint's WV:1 priority vector as its queue stores it (mtools:W248); banded by nemik.score (nemik:W131)." .
nemik:vectorSource a rdf:Property ; rdfs:comment "Who wrote the vector: default, signal or agent (mtools:W248)." .
nemik:dtstart a rdf:Property ; rdfs:comment "RFC 5545 DTSTART value as the queue stores it (mtools:W300; nemik:W134)." .
nemik:due a rdf:Property ; rdfs:comment "RFC 5545 DUE value as the queue stores it (mtools:W300; nemik:W134)." .
nemik:alarm a rdf:Property ; rdfs:comment "One RFC 5545 VALARM TRIGGER as the queue stores it (mtools:W279); resolved by nemik.alarm (nemik:W129)." .
nemik:rrule a rdf:Property ; rdfs:comment "RFC 5545 RRULE as the queue stores it (mtools:W309)." .
nemik:exdate a rdf:Property ; rdfs:comment "One RFC 5545 EXDATE value as the queue stores it (mtools:W309)." .
nemik:occurrenceDone a rdf:Property ; rdfs:comment "RECURRENCE-ID of a completed occurrence (mtools:W310 occurrences map); nemik.alarm skips it." .
nemik:queuePosition a rdf:Property ; rdfs:comment "0-based index of the waypoint in mtools' model.ordered(): the order its own session works the queue." .
nemik:mintedDuring a rdf:Property ; rdfs:comment "tick | interrupt: whether a live tick lock was held when mtools minted the waypoint." .
nemik:waitsFor a rdf:Property ; rdfs:comment "An edge nemik resolved from free-text blocked_on: to a waypoint (local or repo:W<n>), a workstream, or the operator." .
nemik:stringNotList a rdf:Property ; rdfs:comment "Names a list field (enables, touches, blocked_on) the queue stores as a bare string." .
nemik:unclaimedBlockOn a rdf:Property ; rdfs:comment "This open waypoint waits on the object workstream, and no waypoint of that workstream enables it or was caused by it." .
nemik:operatorAsk a rdf:Property ; rdfs:comment "needs-you | answered | condition | unstated: nemik's reading of a block on the operator (nemik.blocks.operator_category)." .
nemik:ticksBlocked a rdf:Property ; rdfs:comment "mtools' ticks_blocked counter." .
nemik:unresolvedBlocker a rdf:Property ; rdfs:comment "A blocked_on value on a blocked waypoint that resolves to no workstream, waypoint or operator." .
nemik:pathsforwardAdoption a rdf:Property ; rdfs:comment "declared | owner | missing | no-pyproject | unobservable: whether the workstream runs mikemol-paths-forward from its own environment (nemik.adoption)." .
nemik:weather a rdf:Property ; rdfs:comment "nemik:W174: a hash of the waypoint's witness query; equal values wait on the same outage. The query text is not in the graph." .
