@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oslc_cm: <http://open-services.net/ns/cm#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix nemik: <https://github.com/mikemol/nemik/ns#> .

nemik:WaypointShape a sh:NodeShape ;
    sh:targetClass oslc_cm:ChangeRequest ;
    sh:property [ sh:path nemik:workstream ; sh:minCount 1 ; sh:maxCount 1 ; sh:class nemik:Workstream ] ;
    sh:property [ sh:path nemik:symbol ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^W[0-9]+$" ] ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ;
                  sh:message "one title per symbol: two means the symbol is both live and in residue (or duplicated)" ] ;
    sh:property [ sh:path oslc_cm:state ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( nemik:Ready nemik:Working nemik:Blocked nemik:LandedStatus nemik:Done ) ;
                  sh:severity sh:Warning ;
                  sh:message "status outside ready, working, blocked, landed and done (vocabulary divergence)" ] ;
    sh:property [ sh:path oslc_cm:closed ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path nemik:enables ; sh:or ( [ sh:class oslc_cm:ChangeRequest ] [ sh:class nemik:Dropped ] ) ;
                  sh:message "enables names a symbol that is neither a waypoint nor residue in any workstream" ] ;
    sh:property [ sh:path nemik:blockedKind ; sh:maxCount 1 ; sh:in ( "agent" "human" ) ;
                  sh:severity sh:Warning ;
                  sh:message "blocked_kind outside agent|human (vocabulary divergence, not yet agreed)" ] .

# A bundled title is advice to decompose, which only open work can take: splitting a done waypoint
# is noise (nemik:W116, aeternum 2026-09-28: five of its title warnings were on done waypoints).
nemik:BundledTitleShape a sh:NodeShape ;
    sh:targetClass oslc_cm:ChangeRequest ;
    sh:or ( [ sh:path oslc_cm:state ; sh:hasValue nemik:Done ]
            [ sh:path dcterms:title ;
              sh:pattern "^(?:.{0,150}|(?=.{151,})(?!.*(?:[;—]| -- )).*)$" ; sh:flags "s" ] ) ;
    sh:severity sh:Warning ;
    sh:message "title over 150 chars AND names more than one clause (has a ';', '—' or ' -- '): likely several steps bundled into one flat waypoint; consider decomposing into waypoints joined by real enables edges. Refined 2026-09-26 from a length-only rule after a fleet sample showed ~50% false positives (verbose-but-atomic titles); this pattern's own false-positive rate on the same sample is ~12% (nemik:W23)" .

# caused_by resolves like enables (nemik:W108): a <repo>:W<n> or W<n> that is neither a waypoint
# nor residue anywhere was cited wrong (nemik:W107 cited luthen:W190 for luthen-observability:W190).
# A Warning, not a Violation: the cause is history, and nothing downstream waits on it. The message
# names the unresolved reference, since the focus alone does not say which one.
# It fires on done waypoints too. A reference that resolves nowhere is broken data, like a dangling
# enables (which WaypointShape checks on every waypoint); only ADVICE about what to do next (decompose
# a title, trim a landed blocker, cite the child of an umbrella) is limited to open work (W116).
nemik:CausedByResolvesShape a sh:NodeShape ;
    sh:targetSubjectsOf prov:wasInformedBy ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "caused_by names {?value}, which is neither a waypoint nor residue in any workstream: fix the repo prefix or the symbol" ;
        sh:select """
            SELECT $this ?value WHERE {
                $this <http://www.w3.org/ns/prov#wasInformedBy> ?cause .
                FILTER (isIRI(?cause))
                FILTER NOT EXISTS { ?cause a <http://open-services.net/ns/cm#ChangeRequest> }
                FILTER NOT EXISTS { ?cause a <https://github.com/mikemol/nemik/ns#Dropped> }
                BIND (REPLACE(STR(?cause), "^urn:nemik:([^/]+)/", "$1:") AS ?value)
            }""" ] .

# An edge into residue resolves, but is stale: the dropped item cannot be enabled any more.
nemik:EdgeIntoDroppedShape a sh:NodeShape ;
    sh:targetObjectsOf nemik:enables ;
    sh:not [ sh:class nemik:Dropped ] ;
    sh:severity sh:Warning ;
    sh:message "edge into a dropped item (stale enables)" .

# A blocked waypoint must say what it is blocked on and whose kind of block it is.
nemik:BlockedShape a sh:NodeShape ;
    sh:targetSubjectsOf oslc_cm:state ;
    sh:or ( [ sh:not [ sh:path oslc_cm:state ; sh:hasValue nemik:Blocked ] ]
            [ sh:and ( [ sh:path nemik:blockedOn ; sh:minCount 1 ]
                       [ sh:path nemik:blockedKind ; sh:minCount 1 ] ) ] ) ;
    sh:severity sh:Warning ;
    sh:message "a blocked waypoint must carry blockedOn and blockedKind" .

# A list field stored as a bare string reads as one element, however many symbols it holds.
nemik:ListFieldShape a sh:NodeShape ;
    sh:targetSubjectsOf nemik:stringNotList ;
    sh:property [ sh:path nemik:stringNotList ; sh:maxCount 0 ; sh:severity sh:Warning ;
                  sh:message "a list field (enables, touches or blocked_on) is stored as a bare string" ] .

# A block on another workstream that neither side can cite by symbol.
nemik:UnclaimedBlockShape a sh:NodeShape ;
    sh:targetSubjectsOf nemik:unclaimedBlockOn ;
    sh:property [ sh:path nemik:unclaimedBlockOn ; sh:maxCount 0 ; sh:severity sh:Warning ;
                  sh:message "blocked on another workstream, and no waypoint there claims it: cite <repo>:W<n> in blocked_on, or the blocker adds a waypoint with --enables <this repo>:W<n>" ] .

# Blocks on the operator that do not ask the operator for anything.
nemik:OperatorAskShape a sh:NodeShape ;
    sh:targetSubjectsOf nemik:operatorAsk ;
    sh:property [ sh:path nemik:operatorAsk ; sh:not [ sh:in ( "unstated" ) ] ; sh:severity sh:Warning ;
                  sh:message "blocked on the operator with no stated ask: write blocked_on as 'operator: decide <question>' or 'operator: act <what only the operator can do>'" ] ;
    sh:property [ sh:path nemik:operatorAsk ; sh:not [ sh:in ( "answered" ) ] ; sh:severity sh:Warning ;
                  sh:message "blocked on the operator, but blocked_on records the operator's answer already: lift the block, or re-file it against the condition it waits on" ] ;
    # nemik:W458 (OperatorActShape): an act ask with no command in the standard shape is an unwritten tool.
    sh:property [ sh:path nemik:operatorAsk ; sh:not [ sh:in ( "no-command" ) ] ; sh:severity sh:Warning ;
                  sh:message "blocked on 'operator: act' with nothing to run: put the verbatim command (env -C <repo> <abs interpreter> -m <module> ..., or sudo <abs path>|env -C ...), its expected output and when it is done into blocked_on; until then the owner owes a tool" ] .

# nemik:W544 (mtools:W1276): open work whose next step names a repo file should declare file:<path>!w
# for what it edits; pathsforward --overlaps flags a real edit collision only on declared writes. A
# Warning, and a SPARQL rule over the emitted nemik:namesFile paths, not a Python marker.
nemik:EditDeclaredShape a sh:NodeShape ;
    sh:targetClass oslc_cm:ChangeRequest ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "next step names {?file} but the card declares no file:<path>!w touches: declare what it edits so --overlaps can flag an edit collision" ;
        sh:select """
            SELECT $this ?file WHERE {
                $this <http://open-services.net/ns/cm#state> ?state .
                FILTER (?state IN (<https://github.com/mikemol/nemik/ns#Ready>, <https://github.com/mikemol/nemik/ns#Working>))
                $this <https://github.com/mikemol/nemik/ns#namesFile> ?file .
                FILTER NOT EXISTS {
                    $this <https://github.com/mikemol/nemik/ns#touches> ?tag .
                    FILTER (STRSTARTS(?tag, "file:"))
                }
            }""" ] .

# nemik:W545 (mtools:W1279): a next step is checkable when it names a repo file (the same
# nemik:namesFile facts as EditDeclaredShape); whether it is already done is machine-readable only
# through a witness (mtools:W1260), since --check-evidence reads only path existence. nemik:weather is
# emitted only from a witness, so its absence means none is declared. A Warning, not a Violation.
nemik:CheckableNextStepShape a sh:NodeShape ;
    sh:targetClass oslc_cm:ChangeRequest ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "next step names {?file}, so whether it is done is checkable, but the card declares no witness: add --witness (and --witness-lang) so the step can be marked done by a query, not by reading prose" ;
        sh:select """
            SELECT $this ?file WHERE {
                $this <http://open-services.net/ns/cm#state> ?state .
                FILTER (?state IN (<https://github.com/mikemol/nemik/ns#Ready>, <https://github.com/mikemol/nemik/ns#Working>))
                $this <https://github.com/mikemol/nemik/ns#namesFile> ?file .
                FILTER NOT EXISTS { $this <https://github.com/mikemol/nemik/ns#weather> ?w }
            }""" ] .

# nemik:W553 (github-8f 2026-10-15): open work whose next step uses a word that blurs the change-lifecycle
# steps (nemik:ChangeLifecycle: landed, installed, held, enabled, active, applied) should name the step.
# The word set is the adapter's; the verdict of a run (mtools corpus/exit-table.json, mtools:W1294) is a
# separate axis. A Warning, and only for ready or working cards.
nemik:LifecycleWordShape a sh:NodeShape ;
    sh:targetClass oslc_cm:ChangeRequest ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "next step says '{?word}', which blurs the change-lifecycle steps: say landed, installed, held, enabled, active or applied (nemik:ChangeLifecycle)" ;
        sh:select """
            SELECT $this ?word WHERE {
                $this <http://open-services.net/ns/cm#state> ?state .
                FILTER (?state IN (<https://github.com/mikemol/nemik/ns#Ready>, <https://github.com/mikemol/nemik/ns#Working>))
                $this <https://github.com/mikemol/nemik/ns#strayWord> ?word .
            }""" ] .

# nemik:W555: the same words in a run row's detail (a prov:Activity from runrows.run_graph). The run's
# verdict (mtools corpus/exit-table.json, mtools:W1294) is the other axis and is not judged here: a run
# that exits INSTALLED reached the installed step only if its detail says so. An Info, not a Warning,
# since a log's text is written once and cannot be amended.
nemik:LifecycleRunWordShape a sh:NodeShape ;
    sh:targetClass prov:Activity ;
    sh:severity sh:Info ;
    sh:sparql [
        sh:message "run detail says '{?word}', which blurs the change-lifecycle steps: say landed, installed, held, enabled, active or applied (nemik:ChangeLifecycle)" ;
        sh:select """
            SELECT $this ?word WHERE {
                $this <https://github.com/mikemol/nemik/ns#strayWord> ?word .
            }""" ] .

# Blocked on another workstream's umbrella rather than on the child step doing the work (W41).
# nemik:W529: a SPARQL constraint over the enables and waitsFor edges; an umbrella is a card two or more of
# whose own repo's open cards enable it (a target with exactly one is a chain step, nemik:W144).
nemik:UmbrellaBlockShape a sh:NodeShape ;
    sh:targetClass oslc_cm:ChangeRequest ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "blocked on another workstream's umbrella waypoint {?umbrella} (two or more of its own open children enable it): cite the child step that actually unblocks you, <repo>:W<n>" ;
        sh:select """
            SELECT DISTINCT $this ?umbrella WHERE {
                $this <https://github.com/mikemol/nemik/ns#waitsFor> ?umbrella ;
                      <https://github.com/mikemol/nemik/ns#workstream> ?mine ;
                      <http://open-services.net/ns/cm#state> ?state .
                FILTER(?state != <https://github.com/mikemol/nemik/ns#Done>)
                ?umbrella <https://github.com/mikemol/nemik/ns#workstream> ?theirs .
                FILTER(?theirs != ?mine)
                ?one <https://github.com/mikemol/nemik/ns#enables> ?umbrella ;
                     <https://github.com/mikemol/nemik/ns#workstream> ?theirs ;
                     <http://open-services.net/ns/cm#state> ?oneState .
                ?two <https://github.com/mikemol/nemik/ns#enables> ?umbrella ;
                     <https://github.com/mikemol/nemik/ns#workstream> ?theirs ;
                     <http://open-services.net/ns/cm#state> ?twoState .
                FILTER(?one != ?two
                       && ?oneState != <https://github.com/mikemol/nemik/ns#Done>
                       && ?twoState != <https://github.com/mikemol/nemik/ns#Done>)
            }""" ] .

# Ready or working, but an umbrella over two or more open children of its own (nemik:W436; SPARQL, W529).
nemik:ReadyUmbrellaShape a sh:NodeShape ;
    sh:targetClass oslc_cm:ChangeRequest ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "ready, but an umbrella: two or more of its own open cards enable it; set it blocked on them (it lands when they do), or drop the enables edges that are not prerequisites" ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <http://open-services.net/ns/cm#state> ?state ;
                      <https://github.com/mikemol/nemik/ns#workstream> ?ws .
                FILTER(?state = <https://github.com/mikemol/nemik/ns#Ready>
                       || ?state = <https://github.com/mikemol/nemik/ns#Working>)
                ?one <https://github.com/mikemol/nemik/ns#enables> $this ;
                     <https://github.com/mikemol/nemik/ns#workstream> ?ws ;
                     <http://open-services.net/ns/cm#state> ?oneState .
                ?two <https://github.com/mikemol/nemik/ns#enables> $this ;
                     <https://github.com/mikemol/nemik/ns#workstream> ?ws ;
                     <http://open-services.net/ns/cm#state> ?twoState .
                FILTER(?one != ?two
                       && ?oneState != <https://github.com/mikemol/nemik/ns#Done>
                       && ?twoState != <https://github.com/mikemol/nemik/ns#Done>)
            }""" ] .

# An umbrella whose children are all done is realized by construction (nemik:W488; mtools:W1139's
# --close-umbrellas closes it). Exactly mtools' set: open, not working, no next step stated, no foreign
# blocker, and one or more local children (cards of the same repo that enable it), all done. A dropped
# child is never an enabler in the graph, so it cannot hide behind this rule.
nemik:UmbrellaCompleteShape a sh:NodeShape ;
    sh:targetObjectsOf nemik:enables ;
    sh:severity sh:Info ;
    sh:sparql [
        sh:message "every child of this umbrella is done and it states no next step: it is realized by construction, so close it (mikemol-paths-forward --close-umbrellas --write)" ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://github.com/mikemol/nemik/ns#workstream> ?ws ;
                      <http://open-services.net/ns/cm#state> ?state .
                FILTER(?state != <https://github.com/mikemol/nemik/ns#Done>
                       && ?state != <https://github.com/mikemol/nemik/ns#Working>)
                ?kid <https://github.com/mikemol/nemik/ns#enables> $this ;
                     <https://github.com/mikemol/nemik/ns#workstream> ?ws .
                OPTIONAL { $this <https://github.com/mikemol/nemik/ns#hasNextStep> ?said }
                OPTIONAL {
                    $this <https://github.com/mikemol/nemik/ns#waitsFor> ?far .
                    ?far <https://github.com/mikemol/nemik/ns#workstream> ?other .
                    FILTER(?other != ?ws)
                }
                OPTIONAL {
                    ?unfinished <https://github.com/mikemol/nemik/ns#enables> $this ;
                                <https://github.com/mikemol/nemik/ns#workstream> ?ws ;
                                <http://open-services.net/ns/cm#state> ?unfinishedState .
                    FILTER(?unfinishedState != <https://github.com/mikemol/nemik/ns#Done>)
                }
                OPTIONAL { $this <https://github.com/mikemol/nemik/ns#plannedPath> ?mine }
                FILTER(!BOUND(?said) && !BOUND(?far) && !BOUND(?unfinished) && !BOUND(?mine))
            }""" ] .

# A card with a manifest of its own and every child done (nemik:W737, mtools:W1717). The children
# being done does not show its own work is: it is closed only when its manifest files exist at HEAD
# and a landed commit names it, which a graph cannot see, so this says to check, not to close.
nemik:UmbrellaOwnWorkShape a sh:NodeShape ;
    sh:targetObjectsOf nemik:enables ;
    sh:severity sh:Info ;
    sh:sparql [
        sh:message "every child of this card is done, but it has a manifest of its own: its own work is done only when those files exist at HEAD and a landed commit names it, so check the manifest before closing it" ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://github.com/mikemol/nemik/ns#workstream> ?ws ;
                      <https://github.com/mikemol/nemik/ns#plannedPath> ?mine ;
                      <http://open-services.net/ns/cm#state> ?state .
                FILTER(?state != <https://github.com/mikemol/nemik/ns#Done>
                       && ?state != <https://github.com/mikemol/nemik/ns#Working>)
                ?kid <https://github.com/mikemol/nemik/ns#enables> $this ;
                     <https://github.com/mikemol/nemik/ns#workstream> ?ws .
                OPTIONAL { $this <https://github.com/mikemol/nemik/ns#hasNextStep> ?said }
                OPTIONAL {
                    $this <https://github.com/mikemol/nemik/ns#waitsFor> ?far .
                    ?far <https://github.com/mikemol/nemik/ns#workstream> ?other .
                    FILTER(?other != ?ws)
                }
                OPTIONAL {
                    ?unfinished <https://github.com/mikemol/nemik/ns#enables> $this ;
                                <https://github.com/mikemol/nemik/ns#workstream> ?ws ;
                                <http://open-services.net/ns/cm#state> ?unfinishedState .
                    FILTER(?unfinishedState != <https://github.com/mikemol/nemik/ns#Done>)
                }
                FILTER(!BOUND(?said) && !BOUND(?far) && !BOUND(?unfinished))
            }""" ] .

# An open card with no edge at all (nemik:W487): nothing enables it, it enables nothing, it waits on
# nothing and nothing waits on it, so no path joins it to any goal. Staged at Info first with the
# fleet count, as ReadyBehindOpenShape was.
nemik:OrphanLeafShape a sh:NodeShape ;
    sh:targetClass oslc_cm:ChangeRequest ;
    sh:severity sh:Info ;
    sh:sparql [
        sh:message "no edge joins this open card to any other: add one (--enables <the card or goal that needs it>, or --add-enables), or drop it if it earns no place" ;
        sh:select """
            SELECT $this WHERE {
                $this <http://open-services.net/ns/cm#state> ?state .
                FILTER(?state != <https://github.com/mikemol/nemik/ns#Done>)
                FILTER NOT EXISTS { $this <https://github.com/mikemol/nemik/ns#enables> ?out }
                FILTER NOT EXISTS { ?in <https://github.com/mikemol/nemik/ns#enables> $this }
                FILTER NOT EXISTS { $this <https://github.com/mikemol/nemik/ns#waitsFor> ?far }
                FILTER NOT EXISTS { ?near <https://github.com/mikemol/nemik/ns#waitsFor> $this }
            }""" ] .

# A ready leaf declares its manifest of planned changes (nemik:W612): the exact files it will create or
# edit and a size class, so the stackable pick (nemik:W613) can tell which cards are disjoint. A leaf is
# a ready card no open card enables. Staged at Info, as ReadyBehindOpenShape was, until the count falls.
nemik:ManifestShape a sh:NodeShape ;
    sh:targetClass oslc_cm:ChangeRequest ;
    sh:severity sh:Info ;
    sh:sparql [
        sh:message "ready leaf with no manifest of planned changes: declare the files it will create or edit, and its size, with --update <W> --manifest <path>... --size small|medium|large (atomize it until each leaf has one)" ;
        sh:select """
            SELECT $this WHERE {
                $this <http://open-services.net/ns/cm#state> <https://github.com/mikemol/nemik/ns#Ready> .
                FILTER NOT EXISTS { $this <https://github.com/mikemol/nemik/ns#plannedPath> ?path }
                FILTER NOT EXISTS {
                    ?kid <https://github.com/mikemol/nemik/ns#enables> $this ;
                         <http://open-services.net/ns/cm#state> ?kidState .
                    FILTER(?kidState != <https://github.com/mikemol/nemik/ns#Done>)
                }
            }""" ] .

# A card declared large is not a leaf yet (nemik:W612): it is atomized until its pieces are small or medium.
nemik:OversizeShape a sh:NodeShape ;
    sh:targetClass oslc_cm:ChangeRequest ;
    sh:severity sh:Info ;
    sh:sparql [
        sh:message "declared size large: atomize it into small or medium cards joined by enables edges before it is worked or stacked" ;
        sh:select """
            SELECT $this WHERE {
                $this <http://open-services.net/ns/cm#state> ?state ;
                      <https://github.com/mikemol/nemik/ns#sizeClass> "large" .
                FILTER(?state = <https://github.com/mikemol/nemik/ns#Ready>
                       || ?state = <https://github.com/mikemol/nemik/ns#Working>)
            }""" ] .

# Ready, but an open card enables it (nemik:W465): it cannot land first. mtools:W1131's
# --block-behind-open applies the fix.
nemik:ReadyBehindOpenShape a sh:NodeShape ;
    sh:targetSubjectsOf nemik:readyBehindOpen ;
    # Info at first (88 cards fleet-wide on 2026-10-13, 55 in one paperkit chain); a Warning since the
    # count fell to 8 (nemik:W493). The fix is mechanical (mtools:W1131's --block-behind-open).
    sh:property [ sh:path nemik:readyBehindOpen ; sh:maxCount 0 ; sh:severity sh:Warning ;
                  sh:message "ready, but an open card enables it: it waits on that card, so set it blocked on it (it becomes ready when that lands), or drop the enables edge if it is not a prerequisite" ] .

# Blocked, but on nothing the graph can reach: no edge can be drawn and no one can be nudged.
nemik:UnresolvedBlockerShape a sh:NodeShape ;
    sh:targetSubjectsOf nemik:unresolvedBlocker ;
    sh:property [ sh:path nemik:unresolvedBlocker ; sh:maxCount 0 ; sh:severity sh:Warning ;
                  sh:message "blocked on no resolvable party: name a repo, a <repo>:W<n>, 'operator: decide/act ...', a cal:<label>/<uid> or a host:<id> (a row luthen's host-apply export holds)" ] .

# Blocked on a waypoint that has already landed, done or dropped (nemik:W110, paperkit's letter).
# nemik:W529: the per-blocker rule is a SPARQL constraint over the emitted nemik:waitsFor edges, so the
# rule lives here and the adapter plumbs no marker for it; "every blocker landed" stays a derived marker
# because it compares a count of blocked_on entries.
nemik:LandedBlockerShape a sh:NodeShape ;
    sh:targetClass oslc_cm:ChangeRequest ;
    sh:targetSubjectsOf nemik:allBlockersLanded ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:severity sh:Warning ;
        sh:message "blocked_on names {?landed}, a waypoint that has already landed (done or dropped): trim it from blocked_on (mikemol-paths-forward --prune-landed --root <fleet root> prunes local and foreign repo:W<n> ones)" ;
        sh:select """
            SELECT $this ?landed WHERE {
                $this <https://github.com/mikemol/nemik/ns#waitsFor> ?landed .
                { ?landed <http://open-services.net/ns/cm#state> <https://github.com/mikemol/nemik/ns#Done> }
                UNION
                { ?landed a <https://github.com/mikemol/nemik/ns#Dropped> }
                FILTER NOT EXISTS { $this <http://open-services.net/ns/cm#state> <https://github.com/mikemol/nemik/ns#Done> }
            }""" ] ;
    sh:property [ sh:path nemik:allBlockersLanded ; sh:maxCount 0 ; sh:severity sh:Warning ;
                  sh:message "every blocker in blocked_on has landed: this waypoint is ready, not blocked" ] .

# A blocked_on entry that is a symbol with prose run on; it draws no edge, so it never lands.
# nemik:W529: a SPARQL constraint over the emitted nemik:blockedOn text (the entry, trimmed, begins with a
# symbol and runs on), so the rule lives here and the adapter plumbs no marker for it.
nemik:MalformedBlockerShape a sh:NodeShape ;
    sh:targetClass oslc_cm:ChangeRequest ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "blocked_on entry {?entry} is a symbol with prose attached: write W<n> or <repo>:W<n> alone, and put the reason in evidence" ;
        sh:select """
            SELECT $this ?entry WHERE {
                $this <https://github.com/mikemol/nemik/ns#blockedOn> ?entry .
                BIND(REPLACE(STR(?entry), "^[ \t]+|[ \t]+$", "") AS ?trimmed)
                FILTER(REGEX(?trimmed, "^([A-Za-z0-9_.-]+:)?W[0-9]+[^A-Za-z0-9_]"))
            }""" ] .

# The operator's intent: each repo installs mikemol-pathsforward and runs it from its own .venv.
nemik:AdoptionShape a sh:NodeShape ;
    sh:targetSubjectsOf nemik:pathsforwardAdoption ;
    sh:property [ sh:path nemik:pathsforwardAdoption ; sh:not [ sh:in ( "missing" "no-pyproject" ) ] ;
                  sh:severity sh:Warning ;
                  sh:message "the queue's writer is not this repo's own dependency: uv add a sha-pinned mikemol-pathsforward (mtools INSTALL.md) and run .venv/bin/mikemol-paths-forward" ] .

# One active card per repo unless everything open is blocked (nemik:W177, operator 2026-10-01).
# nemik:W529: SPARQL constraints over the workstream's cards, so the rule lives here and the adapter plumbs
# no count marker for it.
nemik:ActiveCardShape a sh:NodeShape ;
    sh:targetObjectsOf nemik:workstream ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:severity sh:Warning ;
        sh:message "no working card while items are ready: mark the one you are doing with --update <W> --status working" ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                ?ready <https://github.com/mikemol/nemik/ns#workstream> $this ;
                       <http://open-services.net/ns/cm#state> <https://github.com/mikemol/nemik/ns#Ready> .
                OPTIONAL {
                    ?working <https://github.com/mikemol/nemik/ns#workstream> $this .
                    { ?working <http://open-services.net/ns/cm#state> <https://github.com/mikemol/nemik/ns#Working> }
                    UNION
                    { ?working <https://github.com/mikemol/nemik/ns#inGate> ?gate }
                }
                FILTER(!BOUND(?working))
            }""" ] .

# nemik:W540 (operator 2026-10-15, session 695f3e0a line 68086: "requiring the working card count to be ==1
# is fragile and puts backpressure in some of the wrong places"): there is no shape for MORE than one
# working card. The zero-working-while-ready rule above stays; staleness of a working card is W616's.

# nemik:W599 (operator 2026-10-16 via github-8f: transcript needles of operator utterances are provenance,
# "that's why we call them warrants"): the contract a warrant is written to, W3C PROV-O. The transcript
# record is a prov:Entity (IRI file:///path#uuid) the card's judgement prov:wasDerivedFrom; it was
# generated at a time (prov:generatedAtTime), by an utterance (a prov:Activity), and is attributed to
# the one who spoke (a prov:Agent: the operator is urn:nemik:operator). mtools:W1384 writes the JSON-LD
# on the card and validates against this shape; nemik:W598 reads it into the graph.
# nemik:W597 (operator 2026-10-16 via github-8f: a ruling lives as provenance, not as prose that stays
# lost in the sea): an open card whose prose claims an operator ruling needs the transcript record.
nemik:UnwarrantedRulingShape a sh:NodeShape ;
    sh:targetSubjectsOf nemik:claimsRuling ;
    sh:property [ sh:path nemik:claimsRuling ; sh:maxCount 0 ; sh:severity sh:Warning ;
                  sh:message "this card claims an operator ruling in prose and carries no warrant: attach the transcript record with mikemol-paths-forward --warrant SYMBOL --transcript PATH --uuid UUID (nemik:W597)" ] .

nemik:MalformedWarrantShape a sh:NodeShape ;
    sh:targetSubjectsOf nemik:malformedWarrant ;
    sh:property [ sh:path nemik:malformedWarrant ; sh:maxCount 0 ; sh:severity sh:Warning ;
                  sh:message "an entry of this card's warrants list is not valid JSON-LD: rewrite it with mikemol-paths-forward --warrant (nemik:W598)" ] .

nemik:WarrantRecordShape a sh:NodeShape ;
    sh:targetObjectsOf prov:wasDerivedFrom ;
    sh:property [ sh:path prov:generatedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
                  sh:message "a warrant's transcript record needs prov:generatedAtTime, one xsd:dateTime (the record's timestamp)" ] ;
    sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:class prov:Agent ;
                  sh:message "a warrant's transcript record needs prov:wasAttributedTo a prov:Agent (the operator is urn:nemik:operator)" ] ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:class prov:Activity ;
                  sh:message "a warrant's transcript record needs prov:wasGeneratedBy the utterance, a prov:Activity" ] .

# A retro with no precommit is narrative only (nemik:W648, gate G0): nothing recorded what the card
# predicted at mint time, so the retro cannot say how the prediction missed.
nemik:RetroPrecommitShape a sh:NodeShape ;
    sh:targetClass nemik:Retro ;
    sh:severity sh:Info ;
    sh:sparql [
        sh:message "narrative only: this retro records no precommit (the card's mint-time next step and witness), so it cannot show how the prediction missed" ;
        sh:select """
            SELECT $this WHERE {
                $this a <https://github.com/mikemol/nemik/ns#Retro> .
                FILTER NOT EXISTS {
                    $this <https://github.com/mikemol/nemik/ns#precommit> ?p .
                    FILTER(STRLEN(STR(?p)) > 0)
                }
            }""" ] .

# A retro names a trigger and a root, and they differ (nemik:W648, gate G3): the trigger is the
# symptom that started the review, the root is why it could happen.
nemik:RetroRootShape a sh:NodeShape ;
    sh:targetClass nemik:Retro ;
    sh:severity sh:Violation ;
    sh:sparql [
        sh:message "a retro must name its trigger and its root" ;
        sh:select """
            SELECT $this WHERE {
                $this a <https://github.com/mikemol/nemik/ns#Retro> .
                FILTER (
                    NOT EXISTS { $this <https://github.com/mikemol/nemik/ns#trigger> ?t . FILTER(STRLEN(STR(?t)) > 0) }
                    || NOT EXISTS { $this <https://github.com/mikemol/nemik/ns#root> ?r . FILTER(STRLEN(STR(?r)) > 0) }
                )
            }""" ] ;
    sh:sparql [
        sh:message "the root equals the trigger: the trigger is the symptom, the root is why it could happen" ;
        sh:select """
            SELECT $this WHERE {
                $this <https://github.com/mikemol/nemik/ns#trigger> ?t ;
                      <https://github.com/mikemol/nemik/ns#root> ?r .
                FILTER(STR(?t) = STR(?r))
            }""" ] .

# A retro's root names a condition, not a person or a lapse (nemik:W649, gate G5). A lexical check: it
# catches blame WORDING, not blame in substance, so it is a Warning to rewrite, never a verdict. The
# word list is whole words, matched without backslashes (a Turtle string would eat them).
nemik:RetroBlamelessShape a sh:NodeShape ;
    sh:targetClass nemik:Retro ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "the root reads as blame (wording check only; it cannot judge substance): say what made the action reasonable at the time, for example 'X forgot Y' becomes 'nothing reminded X of Y', 'failed to check' becomes 'the check was not part of the step'" ;
        sh:select """
            SELECT $this WHERE {
                $this <https://github.com/mikemol/nemik/ns#root> ?r .
                FILTER(REGEX(CONCAT(" ", STR(?r), " "), "[^a-z](forgot|forgetting|forgotten|failed to|failure to|should have|shouldn't have|should not have|careless|carelessly|negligent|negligence|sloppy|lazy|laziness|incompetent|didn't bother|did not bother|ignored|neglected|human error|operator error|user error|blame|blamed|fault of|their fault|his fault|her fault)[^a-z]", "i"))
            }""" ] .

# A retro records what to sustain as well as what to fix (nemik:W649, gate G6). Empty is thin, said in
# the commit-message draft's own words (`# thin: no <field>`, mtools commitmsg): the gap is stated, not
# hidden, and it stays Info because a retro with nothing worth keeping is rare but possible.
nemik:RetroSustainShape a sh:NodeShape ;
    sh:targetClass nemik:Retro ;
    sh:severity sh:Info ;
    sh:sparql [
        sh:message "thin: no sustain. Say what worked and should be kept, beside what went wrong" ;
        sh:select """
            SELECT $this WHERE {
                $this a <https://github.com/mikemol/nemik/ns#Retro> .
                FILTER NOT EXISTS {
                    $this <https://github.com/mikemol/nemik/ns#sustain> ?s .
                    FILTER(STRLEN(STR(?s)) > 0)
                }
            }""" ] .

# A retro finding is an action (nemik:W754, gate G7): it references a card that carries the fix, with
# an owner, a due date and a witness, or a --certify verdict change. A finding that is neither is an
# observation, and a retro of observations changes nothing.
nemik:RetroFindingShape a sh:NodeShape ;
    sh:targetClass nemik:RetroFinding ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "a retro finding must reference a card (findingCard) or a --certify verdict change (certifyChange); otherwise it is an observation, not an action" ;
        sh:select """
            SELECT $this WHERE {
                $this a <https://github.com/mikemol/nemik/ns#RetroFinding> .
                FILTER NOT EXISTS { $this <https://github.com/mikemol/nemik/ns#findingCard> ?c }
                FILTER NOT EXISTS { $this <https://github.com/mikemol/nemik/ns#certifyChange> ?v }
            }""" ] ;
    sh:sparql [
        sh:message "a retro finding's card needs an owner (findingOwner), a due date (due) and a witness (findingWitness)" ;
        sh:select """
            SELECT $this WHERE {
                $this <https://github.com/mikemol/nemik/ns#findingCard> ?c .
                FILTER (
                    NOT EXISTS { $this <https://github.com/mikemol/nemik/ns#findingOwner> ?o . FILTER(STRLEN(STR(?o)) > 0) }
                    || NOT EXISTS { $this <https://github.com/mikemol/nemik/ns#due> ?d . FILTER(STRLEN(STR(?d)) > 0) }
                    || NOT EXISTS { $this <https://github.com/mikemol/nemik/ns#findingWitness> ?w . FILTER(STRLEN(STR(?w)) > 0) }
                )
            }""" ] .

# A retro handoff names its instrument, its channel and who operates it (nemik:W755, gate G8). Another
# operator is refused unless the retro records that it tried the handoff itself and the try failed: a
# step handed to someone else that its own author never tried is how asks reach the operator needlessly.
nemik:RetroHandoffShape a sh:NodeShape ;
    sh:targetClass nemik:RetroHandoff ;
    sh:severity sh:Violation ;
    sh:sparql [
        sh:message "a retro handoff must name its instrument, its channel and its operator (self or other)" ;
        sh:select """
            SELECT $this WHERE {
                $this a <https://github.com/mikemol/nemik/ns#RetroHandoff> .
                FILTER (
                    NOT EXISTS { $this <https://github.com/mikemol/nemik/ns#handoffInstrument> ?i . FILTER(STRLEN(STR(?i)) > 0) }
                    || NOT EXISTS { $this <https://github.com/mikemol/nemik/ns#handoffChannel> ?c . FILTER(STRLEN(STR(?c)) > 0) }
                    || NOT EXISTS { $this <https://github.com/mikemol/nemik/ns#handoffOperator> ?o . FILTER(STR(?o) IN ("self", "other")) }
                )
            }""" ] ;
    sh:sparql [
        sh:message "the handoff goes to another operator with no self probe recorded executed-and-failed: try it yourself first, and record the result" ;
        sh:select """
            SELECT $this WHERE {
                $this <https://github.com/mikemol/nemik/ns#handoffOperator> ?o .
                FILTER(STR(?o) = "other")
                FILTER NOT EXISTS { $this <https://github.com/mikemol/nemik/ns#selfProbe> ?p . FILTER(STR(?p) = "executed-and-failed") }
            }""" ] .

# A retro names how strongly its fix is enforced (nemik:W651, gate G9). The layers run weakest to
# strongest: memory, instructions, trigger, hook, gate. A failure class that has recurred and is
# fixed below the hook layer is refused unless the retro declares it a one-off: a reminder is what
# failed the first time.
nemik:RetroEnforcementShape a sh:NodeShape ;
    sh:targetClass nemik:Retro ;
    sh:severity sh:Violation ;
    sh:sparql [
        sh:message "the enforcement layer must be one of memory, instructions, trigger, hook, gate" ;
        sh:select """
            SELECT $this WHERE {
                $this <https://github.com/mikemol/nemik/ns#enforcementLayer> ?l .
                FILTER(!(STR(?l) IN ("memory", "instructions", "trigger", "hook", "gate")))
            }""" ] ;
    sh:sparql [
        sh:message "a recurring failure class is fixed below the hook layer (memory, instructions or trigger): move the fix to a hook or a gate, or declare the failure a one-off (oneOff true)" ;
        sh:select """
            SELECT $this WHERE {
                $this <https://github.com/mikemol/nemik/ns#recurring> ?r ;
                      <https://github.com/mikemol/nemik/ns#enforcementLayer> ?l .
                FILTER(STR(?r) = "true")
                FILTER(STR(?l) IN ("memory", "instructions", "trigger"))
                FILTER NOT EXISTS { $this <https://github.com/mikemol/nemik/ns#oneOff> ?o . FILTER(STR(?o) = "true") }
            }""" ] .

# A retro carries a computed delta (nemik:W651, gate G2): what changed between the prediction and the
# outcome, worked out and not narrated. Empty or absent is refused, since without it the retro cannot
# say how it differed from the card's precommit.
nemik:RetroDeltaShape a sh:NodeShape ;
    sh:targetClass nemik:Retro ;
    sh:severity sh:Violation ;
    sh:sparql [
        sh:message "a retro needs a non-empty computed delta: what changed between the prediction and the outcome" ;
        sh:select """
            SELECT $this WHERE {
                $this a <https://github.com/mikemol/nemik/ns#Retro> .
                FILTER NOT EXISTS {
                    $this <https://github.com/mikemol/nemik/ns#delta> ?d .
                    FILTER(STRLEN(STR(?d)) > 0)
                }
            }""" ] .

# A retro's timeline is frozen (nemik:W757, gate G1): the ledger lines it reasons from are written
# once and hashed (mtools --retro-freeze), so the retro cannot be fitted to a timeline rewritten
# afterwards. Info, not a verdict: nemik cannot check the hash against the lines, only that one was
# recorded.
nemik:RetroTimelineShape a sh:NodeShape ;
    sh:targetClass nemik:Retro ;
    sh:severity sh:Info ;
    sh:sparql [
        sh:message "no frozen timeline: this retro records no content hash of its write-once timeline (mikemol --retro-freeze), so the timeline can change under it" ;
        sh:select """
            SELECT $this WHERE {
                $this a <https://github.com/mikemol/nemik/ns#Retro> .
                FILTER NOT EXISTS {
                    $this <https://github.com/mikemol/nemik/ns#frozenTimeline> ?h .
                    FILTER(STRLEN(STR(?h)) > 0)
                }
            }""" ] .
