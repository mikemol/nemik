load("@nemik_dev//:requirements.bzl", "all_requirements")
load("//bazel:venv.bzl", "venv_from_hub")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(["pyproject.toml"])

# One target per test module, so a failure is located and an unchanged module is a cache hit.
# nemik:W103: each runs under //:.venv's interpreter (tests/venv_pytest.sh); the venv is the input.
[
    sh_test(
        name = src.removeprefix("tests/").removesuffix(".py"),
        srcs = ["tests/venv_pytest.sh"],
        # nemik:W339: the browser suite is many page loads and grows with each view check; at host
        # load ~100 it crossed medium's 300 s (284 s alone, then a timeout in the gate). The rest stay medium.
        size = "large" if src == "tests/test_layout.py" else "medium",
        args = ["$(rootpath " + src + ")", "-c", "$(rootpath pyproject.toml)"],
        data = [src, "tests/installed.py", ".claude/settings.json", "//tests/fixtures:fleet", "pyproject.toml", "ARCHITECTURE.md", "skills/nemik/SKILL.md", "docs/positioning.md", "src/nemik/data/workflows.toml"] + glob(["tests/corpus/**"]) + [ "src/nemik/data/shapes.ttl", ":.venv", "@opa//file", "@use_of_colour_rego//file", "@chromium//:files", "@chromium//:chrome-headless-shell"],
        env = {
            "NEMIK_OPA": "$(rootpath @opa//file)",
            "NEMIK_USE_OF_COLOUR_REGO": "$(rootpath @use_of_colour_rego//file)",
            "NEMIK_CHROMIUM": "$(rootpath @chromium//:chrome-headless-shell)",
        },
    )
    for src in glob(["tests/test_*.py"])
]

# nemik:W96: the distribution's .venv as a build artifact (operator: "install as a package into
# their .venv"): the dev closure, the vendored pathsforward wheel, nemik's own sources, and every
# console script, the same entries as pyproject's [project.scripts] plus pathsforward's own.
venv_from_hub(
    name = ".venv",
    hub_requirements = all_requirements + ["@pathsforward//:pkg", "@icsstruct//:pkg", "@hooks//:pkg", "@fence//:pkg", "@rulerseq//:pkg"],
    python_version = "3.13",
    python_version_short = "3.13",
    srcs = glob(["src/nemik/**"], exclude = ["**/__pycache__/**"]),
    console_scripts = {
        "nemik-check": "nemik.check:main",
        "nemik-metrics": "nemik.metrics:main",
        "nemik-serve": "nemik.serve:main",
        "nemik-inbound": "nemik.blocks_cli:main",
        "nemik-operator": "nemik.blocks_cli:operator_main",
        "nemik-wake": "nemik.wake:main",
        "nemik-rank": "nemik.rank:main",
        "nemik-floor-asks": "nemik.floorasks:main",
        "nemik-overlaps": "nemik.overlaps:main",
        "nemik-witnesses": "nemik.witnesses_cli:main",
        "nemik-ics": "nemik.vtodo:main",
        "nemik-tasks": "nemik.vtodo:tasks_main",
        "mikemol-paths-forward": "mikemol.pathsforward.cli:main",
        "mikemol-ics": "mikemol.icsstruct.cli:main",
        "mikemol-hook-inbound-asks": "mikemol.hooks.entry:inbound_asks_main",
        "mikemol-hook-nemik-check": "mikemol.hooks.entry:nemik_check_main",
        # nemik:W342: the commit kata, so this repo commits through its isolated path (no index lock
        # held through the gate) with its own pinned copy, not another repo's venv.
        "mikemol-commit": "mikemol.hooks.commit_kata:main",
        # nemik:W378: beside the interpreter, where mikemol-commit looks for its commit lock.
        "mikemol-membudget": "mikemol.fence.membudget_cli:main",
        "nemik-days": "nemik.calendars:days_main",
        "nemik-calendar-write": "nemik.calwrite:main",
        "nemik-history": "nemik.history:main",
        "nemik-pins": "nemik.pins:main",
        "nemik-critical": "nemik.critical:main",
        "nemik-work": "nemik.work:main",
        "nemik-starved": "nemik.starved:main",
        "nemik-pacing": "nemik.pacing:main",
        "nemik-export": "nemik.mspdi:main",
    },
)
