load("@nemik_dev//:requirements.bzl", "all_requirements")
load("//bazel:venv.bzl", "venv_from_hub")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(["pyproject.toml"])

# One target per test module, so a failure is located and an unchanged module is a cache hit.
# nemik:W103: each runs under //:.venv's interpreter (tests/venv_pytest.sh); the venv is the input.
[
    sh_test(
        name = src.removeprefix("tests/").removesuffix(".py"),
        srcs = ["tests/venv_pytest.sh"],
        args = ["$(rootpath " + src + ")", "-c", "$(rootpath pyproject.toml)"],
        data = [src, "tests/installed.py", "//tests/fixtures:fleet", "pyproject.toml", "ARCHITECTURE.md", "skills/nemik/SKILL.md", "src/nemik/data/shapes.ttl", ":.venv", "@opa//file", "@chromium//:files", "@chromium//:chrome-headless-shell"],
        env = {
            "NEMIK_OPA": "$(rootpath @opa//file)",
            "NEMIK_CHROMIUM": "$(rootpath @chromium//:chrome-headless-shell)",
        },
    )
    for src in glob(["tests/test_*.py"])
]

# nemik:W96: the distribution's .venv as a build artifact (operator: "install as a package into
# their .venv"): the dev closure, the vendored pathsforward wheel, nemik's own sources, and every
# console script, the same entries as pyproject's [project.scripts] plus pathsforward's own.
venv_from_hub(
    name = ".venv",
    hub_requirements = all_requirements + ["@pathsforward//:pkg"],
    python_version = "3.13",
    python_version_short = "3.13",
    srcs = glob(["src/nemik/**"], exclude = ["**/__pycache__/**"]),
    console_scripts = {
        "nemik-check": "nemik.check:main",
        "nemik-metrics": "nemik.metrics:main",
        "nemik-serve": "nemik.serve:main",
        "nemik-inbound": "nemik.blocks:main",
        "nemik-operator": "nemik.blocks:operator_main",
        "nemik-wake": "nemik.wake:main",
        "nemik-rank": "nemik.rank:main",
        "nemik-floor-asks": "nemik.floorasks:main",
        "nemik-overlaps": "nemik.overlaps:main",
        "nemik-witnesses": "nemik.witnesses:main",
        "nemik-ics": "nemik.vtodo:main",
        "mikemol-paths-forward": "mikemol.pathsforward.cli:main",
    },
)
