load("@nemik_dev//:requirements.bzl", "all_requirements")
load("//bazel:venv.bzl", "venv_from_hub")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(["pyproject.toml"])

# One target per test module, so a failure is located and an unchanged module is a cache hit.
# nemik:W103: each runs under //:.venv's interpreter (tests/venv_pytest.sh); the venv is the input.
[
    sh_test(
        name = src.removeprefix("tests/").removesuffix(".py"),
        srcs = ["tests/venv_pytest.sh"],
        # nemik:W339: the browser suite is many page loads and grows with each view check; at host
        # load ~100 it crossed medium's 300 s (284 s alone, then a timeout in the gate). The rest stay medium.
        size = "large" if src in ("tests/test_layout.py", "tests/test_codon_census.py") else "medium",
        args = ["$(rootpath " + src + ")", "-c", "$(rootpath pyproject.toml)"],
        data = [src, "tests/installed.py", "tests/webpage.py",".claude/settings.json", "//tests/fixtures:fleet", "pyproject.toml", "ARCHITECTURE.md", "skills/nemik/SKILL.md", "docs/positioning.md", "deploy/deployment.yaml", "src/nemik/data/workflows.toml", "tools/nemik_client.py", "BUILD.bazel", "Containerfile"] + glob(["tests/corpus/**"]) + [ "src/nemik/data/shapes.ttl", "src/nemik/data/nemik.ttl", "src/nemik/data/run-row.schema.json", ":.venv", "@opa//file", "@use_of_colour_rego//file", "@chromium//:files", "@chromium//:chrome-headless-shell"]
            # nemik:W445: the JRE (52 MB) and MPXJ's jars go to the one test that reads with them
            + (["@temurin_jre//:files", "@temurin_jre//:bin/java", ":mpxj_classpath"] if src == "tests/test_mpxj.py" else [])
            # nemik:W518: the claims boundary test runs checks/claims.py's read-only witnesses
            + (["checks/claims.py"] if src == "tests/test_claims_boundary.py" else [])
            # nemik:W523: the no-waivers test scans every Python file the repo keeps outside the package
            + (glob(["tests/*.py", "tools/*.py", "checks/*.py"], exclude = [src, "tests/installed.py", "tests/webpage.py", "tools/nemik_client.py", "checks/claims.py"]) if src == "tests/test_no_waivers.py" else [])
            # nemik:W557: the run-row tool runs against the schema it validates with
            + (["tools/check_run_rows.py"] if src == "tests/test_check_run_rows.py" else [])
            # nemik:W543: the mypy ratchet measures every Python file of the four trees against its baseline
            + (["mypy-house.ini", "mypy-baseline.json", "tools/mypy_ratchet.py"] + glob(["src/**/*.py", "tests/*.py", "tools/*.py", "checks/*.py", "stubs/**"], exclude = [src, "tests/installed.py", "tests/webpage.py", "tools/nemik_client.py", "checks/claims.py", "tools/mypy_ratchet.py"], allow_empty = True) if src == "tests/test_mypy_ratchet.py" else [])
            # nemik:W566: the Codon pin test runs the staged compiler
            + (["@codon//:files", "@codon//:bin/codon"] if src == "tests/test_codon_pin.py" else [])
            # nemik:W566: the Codon census compiles every module of the package with the pinned compiler
            + (["@codon//:files", "@codon//:bin/codon", "tools/codon_census.py", "codon-baseline.json"] + glob(["src/nemik/*.py"]) if src == "tests/test_codon_census.py" else [])
            # nemik:W541: the order-sensitive pick test reads every Python file under tests, tools and checks
            + (glob(["tests/*.py", "tools/*.py", "checks/*.py"], exclude = [src, "tests/installed.py", "tests/webpage.py", "tools/nemik_client.py", "checks/claims.py"]) if src == "tests/test_order_sensitive_picks.py" else [])
            # nemik:W521: the gate test reads the hook and the script that runs the //:precommit suite
            + ([".githooks/pre-commit", "tools/gate_staged.sh"] if src == "tests/test_precommit_gate.py" else [])
            # nemik:W589: the replica script's buildctl command line is held to the Containerfile's stage
            # nemik:W593: the flow cases as corpus data, read by the one test that checks them
            + (["tests/flow_cases.py"] if src == "tests/test_flow_corpus.py" else [])
            + (["tools/image_replica.sh", ".githooks/post-commit"] if src == "tests/test_image_replica.py" else [])
            + (["tools/image_replica_runner.sh"] if src == "tests/test_image_replica_runner.py" else [])
            # nemik:W522: the ruff ratchet measures every Python file of the four trees against its baseline
            + (["ruff-house.toml", "ruff-baseline.json"] + glob(["src/**/*.py", "tests/*.py", "tools/*.py", "checks/*.py"], exclude = [src, "tests/installed.py", "tests/webpage.py", "tools/nemik_client.py", "checks/claims.py"]) if src == "tests/test_ruff_ratchet.py" else [])
            # nemik:W475: the input guard reads every test's source to check what each one opens
            + (glob(["tests/test_*.py"], exclude = [src]) if src == "tests/test_test_inputs.py" else []),
        env = {
            "NEMIK_OPA": "$(rootpath @opa//file)",
            "NEMIK_USE_OF_COLOUR_REGO": "$(rootpath @use_of_colour_rego//file)",
            "NEMIK_CHROMIUM": "$(rootpath @chromium//:chrome-headless-shell)",
        } | ({
            "NEMIK_JAVA": "$(rootpath @temurin_jre//:bin/java)",
            "NEMIK_MPXJ_CLASSPATH": "$(rootpaths :mpxj_classpath)",
        } if src == "tests/test_mpxj.py" else {}) | ({
            "NEMIK_CODON": "$(rootpath @codon//:bin/codon)",
        } if src in ("tests/test_codon_pin.py", "tests/test_codon_census.py") else {}),
    )
    for src in glob(["tests/test_*.py"])
]

# nemik:W521: the commit gate as one target: every test above, and (as they land) the lint, type, shell and
# warrant stages. tools/gate_staged.sh runs `bazel test //:precommit`; the hook refuses when bazel is absent.
test_suite(
    name = "precommit",
    tests = [":" + src.removeprefix("tests/").removesuffix(".py") for src in glob(["tests/test_*.py"])],
)

# nemik:W445: MPXJ and the JAXB jars its MSPDI reader needs (pinned in MODULE.bazel)
filegroup(
    name = "mpxj_classpath",
    srcs = ["@mpxj_jar//file", "@jaxb_api_jar//file", "@jaxb_runtime_jar//file", "@jaxb_core_jar//file", "@txw2_jar//file", "@istack_jar//file", "@activation_jar//file"],
)

# nemik:W96: the distribution's .venv as a build artifact (operator: "install as a package into
# their .venv"): the dev closure, the vendored pathsforward wheel, nemik's own sources, and every
# console script, the same entries as pyproject's [project.scripts] plus pathsforward's own.
venv_from_hub(
    name = ".venv",
    hub_requirements = all_requirements + ["@pathsforward//:pkg", "@icsstruct//:pkg", "@hooks//:pkg", "@fence//:pkg", "@rulerseq//:pkg", "@frontier//:pkg"],
    python_version = "3.13",
    python_version_short = "3.13",
    srcs = glob(["src/nemik/**"], exclude = ["**/__pycache__/**"]),
    console_scripts = {
        "nemik-check": "nemik.check:main",
        "nemik-metrics": "nemik.metrics:main",
        "nemik-serve": "nemik.serve:main",
        "nemik-static": "nemik.staticserve:main",
        "nemik-inbound": "nemik.blocks_cli:main",
        "nemik-operator": "nemik.blocks_cli:operator_main",
        "nemik-wake": "nemik.wake:main",
        "nemik-rank": "nemik.rank:main",
        "nemik-floor-asks": "nemik.floorasks:main",
        "nemik-overlaps": "nemik.overlaps:main",
        "nemik-witnesses": "nemik.witnesses_cli:main",
        "nemik-ics": "nemik.vtodo:main",
        "nemik-tasks": "nemik.vtodo:tasks_main",
        "mikemol-paths-forward": "mikemol.pathsforward.cli:main",
        "mikemol-ics": "mikemol.icsstruct.cli:main",
        "mikemol-hook-inbound-asks": "mikemol.hooks.entry:inbound_asks_main",
        "mikemol-hook-nemik-check": "mikemol.hooks.entry:nemik_check_main",
        # nemik:W342: the commit kata, so this repo commits through its isolated path (no index lock
        # held through the gate) with its own pinned copy, not another repo's venv.
        "mikemol-commit": "mikemol.hooks.commit_kata:main",
        # nemik:W538: format, lint and type-check a draft before it lands (replaces tools/pyfmt.sh).
        "mikemol-pycheck": "mikemol.hooks.pycheck_cli:main",
        # nemik:W537: re-vendor the mtools wheels at one commit (replaces tools/revendor-mtools.sh).
        "mikemol-repin": "mikemol.hooks.repin_cli:main",
        # nemik:W378: beside the interpreter, where mikemol-commit looks for its commit lock.
        "mikemol-membudget": "mikemol.fence.membudget_cli:main",
        "nemik-days": "nemik.calendars:days_main",
        "nemik-calendar-write": "nemik.calwrite:main",
        "nemik-history": "nemik.history:main",
        "nemik-pins": "nemik.pins:main",
        "nemik-critical": "nemik.critical:main",
        "nemik-work": "nemik.work:main",
        "nemik-starved": "nemik.starved:main",
        "nemik-replica": "nemik.replica_cli:main",
        "nemik-pacing": "nemik.pacing:main",
        "nemik-export": "nemik.mspdi:main",
        "nemik-import": "nemik.importer:main",
    },
)
