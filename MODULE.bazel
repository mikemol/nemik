"""nemik on Bazel (nemik:W85, W90): which tests run is the build graph's call, not a tick's.

Each tests/test_*.py is its own cached test, so an unchanged tree costs nothing to re-verify
and a change re-runs exactly what depends on it. Each runs under the built //:.venv's interpreter
(nemik:W103, tests/venv_pytest.sh), so the venv is the input every test consumes.
"""

module(name = "nemik", version = "0.1")

bazel_dep(name = "rules_python", version = "2.3.3")
bazel_dep(name = "rules_shell", version = "0.4.1")

# nemik:W102: rules_python patched (mtools' patches/, same measurement) so pip.parse(uv_lock=)
# hands a git source to pip as `name @ git+url@rev` instead of an index requirement.
single_version_override(
    module_name = "rules_python",
    patch_strip = 1,
    patches = [
        "//patches:rules_python-uv-lock-git-kind.patch",
        "//patches:rules_python-uv-lock-local-source.patch",  # nemik-only: path wheels come via wheel.bzl
    ],
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.13", is_default = True)

# nemik:W102: the dev closure is read from uv.lock itself, so the host and Bazel resolve one lock
# (paperkit from its git pin via the patch above). mikemol-pathsforward is a local-path wheel in the
# lock, vendored so the image build never fetches github.com (nemik:W6); it comes in through
# //bazel:wheel.bzl.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "nemik_dev",
    python_version = "3.13",
    uv_lock = "//:uv.lock",
)
use_repo(pip, "nemik_dev")

vendored_wheel = use_repo_rule("//bazel:wheel.bzl", "vendored_wheel")
vendored_wheel(
    name = "pathsforward",
    wheel = "//:vendor/wheels/mikemol_pathsforward-0.1.0+3ded8d1-py3-none-any.whl",
)

# nemik: mtools' hooks (mikemol-hook-inbound-asks, mikemol-hook-nemik-check), vendored at the same sha.
vendored_wheel(
    name = "hooks",
    wheel = "//:vendor/wheels/mikemol_hooks-0.1.0+3ded8d1-py3-none-any.whl",
)

# nemik:W157: mtools' icsstruct (mikemol-ics), vendored the same way at mtools 3ded8d1, one sha across all three.
vendored_wheel(
    name = "icsstruct",
    wheel = "//:vendor/wheels/mikemol_icsstruct-0.1.0+3ded8d1-py3-none-any.whl",
)

# nemik:W378: mtools' fence (mikemol-membudget), at the same sha: mikemol-commit finds it beside the
# interpreter and takes its commit lock with it (mtools:W1016/W1022, github-8f's ruling 2026-10-12).
vendored_wheel(
    name = "fence",
    wheel = "//:vendor/wheels/mikemol_fence-0.1.0+3ded8d1-py3-none-any.whl",
)

# nemik:W417: mtools' rulerseq (mikemol.rulerseq, mtools:W1048), at the same sha: the ruler-sequence
# patterns for halo rings and blocker lines, computed server-side (W418) instead of ported in the page.
vendored_wheel(
    name = "rulerseq",
    wheel = "//:vendor/wheels/mikemol_rulerseq-0.1.0+3ded8d1-py3-none-any.whl",
)

# nemik:W98: opa, the witness evaluator, as a hashed input instead of whatever /usr/bin holds.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
http_file(
    name = "opa",
    url = "https://github.com/open-policy-agent/opa/releases/download/v1.20.2/opa_linux_amd64_static",
    sha256 = "69da5179ee403d10fa11bab6cfb4ffb0d23dba5f9b682fa977db772a1da5670f",
    executable = True,
    downloaded_file_path = "opa",
)

# nemik:W430: el-openglo's use-of-colour requirement (el-openglo:W72, WCAG 1.4.1), pinned at the commit
# that last changed it, never copied: the view's measurement (W429) is evaluated against it (W431).
http_file(
    name = "use_of_colour_rego",
    url = "https://raw.githubusercontent.com/mikemol/el-openglo/3f2bc1276cf3fffa28e6d747aef78e4377244ce4/policy/use_of_colour.rego",
    sha256 = "f1260f5c4b0a2d8ad6e015a40c2dee72da27a75ef9c095d5bbf1fe8c960d985a",
    downloaded_file_path = "use_of_colour.rego",
)

# nemik:W445: a real MSPDI reader for nemik-export (W420): MPXJ and the JAXB jars it needs to read MSPDI,
# found by running it (MPXJ's POM lists ten compile deps; the MSPDI reader needs only these), and a
# full JRE: Bazel's embedded JDK is jlinked without java.desktop, which JAXB's runtime loads.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "temurin_jre",
    url = "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/OpenJDK21U-jre_x64_linux_hotspot_21.0.12.1_1.tar.gz",
    sha256 = "2413149700df0f7d440500a84a8f764c535f21e5a5e87d38328b64eec2c5b500",
    strip_prefix = "jdk-21.0.12.1+1-jre",
    build_file_content = 'filegroup(name = "files", srcs = glob(["**"]), visibility = ["//visibility:public"])\nexports_files(["bin/java"])',
)

[http_file(
    name = name,
    url = "https://repo1.maven.org/maven2/" + path,
    sha256 = sha,
    downloaded_file_path = path.rsplit("/", 1)[-1],
) for name, path, sha in [
    ("mpxj_jar", "net/sf/mpxj/mpxj/16.10.0/mpxj-16.10.0.jar", "0004751793726e73e81b71160a1ed7dd7bdeb80fc2d42484d0504a464a6eddb7"),
    ("jaxb_api_jar", "jakarta/xml/bind/jakarta.xml.bind-api/3.0.1/jakarta.xml.bind-api-3.0.1.jar", "b8fb4bee3ff5b5c1ef77144d8411316018d7bbd41fcf1ede0646f7978546b867"),
    ("jaxb_runtime_jar", "org/glassfish/jaxb/jaxb-runtime/3.0.2/jaxb-runtime-3.0.2.jar", "7b3a3784b9c6e343a8d38fc108602ba810177f03f2d8d1e7258b1cef7fd9d4c7"),
    ("jaxb_core_jar", "org/glassfish/jaxb/jaxb-core/3.0.2/jaxb-core-3.0.2.jar", "f9a360b939597643b2676e35fc497afb561d20e8a513128a5c0070366db11bbd"),
    ("txw2_jar", "org/glassfish/jaxb/txw2/3.0.2/txw2-3.0.2.jar", "b4bcf94fb0a759456e2521724513baec94b78e93127544af162e3cff08d93343"),
    ("istack_jar", "com/sun/istack/istack-commons-runtime/4.0.1/istack-commons-runtime-4.0.1.jar", "9f91115f449384886f572bd62c8812ee1004273d4b5c85cac65179ad4c16990f"),
    ("activation_jar", "com/sun/activation/jakarta.activation/2.0.1/jakarta.activation-2.0.1.jar", "b9e24b7dd6e07495562ea96531be3130c96dba4d78e1dfd88adbbdebf4332871"),
]]

# nemik:W99: the render test's headless Chromium as a hashed input (Playwright's own build of
# chromium_headless_shell-1243, the revision the pinned playwright wheel expects), not ~/.cache.
http_archive(
    name = "chromium",
    url = "https://cdn.playwright.dev/builds/cft/153.0.8010.12/linux64/chrome-headless-shell-linux64.zip",
    sha256 = "a9da028861a0cf789ff25c2fed45f5f1aaf969ed9247835b6a7821a4f7af9d1d",
    strip_prefix = "chrome-headless-shell-linux64",
    build_file_content = """filegroup(name = "files", srcs = glob(["**"]), visibility = ["//visibility:public"])
exports_files(["chrome-headless-shell"])""",
)

